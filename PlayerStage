# -*- dockerfile -*-

FROM mybase:latest

# Playerstage specific here

RUN apt-get install build-essential ruby -yq

WORKDIR /root

RUN wget http://www.cmake.org/files/v2.6/cmake-2.6.2.tar.gz \
&& tar zxf cmake-2.6.2.tar.gz \
&& cd cmake-2.6.2 \
&& make && make install

RUN pip install swig

RUN apt-get install libfltk1.3-dev -yq
RUN apt-get install libtirpc-dev -yq


ADD Makefile /app/Makefile
WORKDIR /app

RUN make player
RUN make stage

# Start sshd daemon
CMD ["/usr/sbin/sshd", "-D"]

# End
